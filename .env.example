PORT=5000
NODE_ENV=development

SUPABASE_URL=your_supabase_project_url
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_JWKS_URL=your_supabase_jwks_url

# Redis Cache Configuration
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Optional response cache - nothing depends on it. Set to true only if a Redis server is running.
REDIS_ENABLED=false
REDIS_DEFAULT_TTL=300

# Direct Postgres connection, only needed for `npm run migrate`
# (Supabase → Project Settings → Database → Connection string → URI, session pooler)
DATABASE_URL=

# Stripe card payments. Use TEST keys (pk_test_ / sk_test_) until you go live.
# The secret key is server-only. STRIPE_WEBHOOK_SECRET (whsec_...) comes from `stripe listen` locally
# or from Dashboard > Developers > Webhooks in production. See STRIPE_SETUP.md.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Reading brand invoices / forwarded emails into a new order (optional).
# Without a key, customers still upload/forward but type the products in by hand.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Only if your API key is not tied to one workspace (error: "not scoped to a workspace"): the workspace ID
ANTHROPIC_WORKSPACE_ID=

# Forwarded brand emails via Postmark inbound.
# INBOUND_EMAIL_ADDRESS = your Postmark server's inbound address (Postmark -> Servers -> Inbound stream).
# Customers get a personal address  <hash>+<their-token>@inbound.postmarkapp.com  (Postmark plus-addressing).
# In Postmark, set the inbound webhook URL to
#   https://inbound:<INBOUND_EMAIL_SECRET>@<your-public-api-host>/api/inbound/email
# INBOUND_EMAIL_SECRET = any long random string (e.g. 48 hex characters) you choose.
INBOUND_EMAIL_ADDRESS=
INBOUND_EMAIL_SECRET=

# Google sign-in. The secret stays on the server; the apps only get the client id from /api/config.
# Google Cloud > APIs & Services > Credentials > your Web client: add http://localhost:4201/login and http://localhost:4200/login
# as Authorized redirect URIs (and the same origins as Authorized JavaScript origins).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
